+private const val SUBPIXEL_MEASUREMENT_SAMPLE = "The_string_of_text_of_big_length_enough_to_properly_measure_size"
+
+internal fun Paint.measureCharWidth(): Float {
+    val total = measureText(SUBPIXEL_MEASUREMENT_SAMPLE)
+    return if (total > 0f) total / SUBPIXEL_MEASUREMENT_SAMPLE.length else measureText("M")
+}
